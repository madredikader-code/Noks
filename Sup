local UI = {}
UI.Objects = {}

function UI.NewWindow(title)
    local screen = Instance.new("ScreenGui")
    screen.Name = "NOKS_UI"
    screen.ResetOnSpawn = false
    screen.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, 420)
    frame.Position = UDim2.new(0.5, -160, 0.3, 0)
    frame.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = screen

    -- drag
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInput.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- header
    local header = Instance.new("TextLabel")
    header.Size = UDim2.new(1, 0, 0, 36)
    header.BackgroundColor3 = Color3.fromRGB(24, 24, 40)
    header.BorderSizePixel = 0
    header.Text = "  " .. title
    header.Font = Enum.Font.GothamBold
    header.TextSize = 16
    header.TextColor3 = Color3.fromRGB(80, 255, 200)
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = frame

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 28)
    close.Position = UDim2.new(1, -30, 0, 4)
    close.BackgroundColor3 = Color3.fromRGB(60, 20, 30)
    close.BorderSizePixel = 0
    close.Text = "✕"
    close.Font = Enum.Font.GothamBold
    close.TextSize = 14
    close.TextColor3 = Color3.fromRGB(255, 120, 120)
    close.Parent = frame
    close.MouseButton1Click:Connect(function()
        screen:Destroy()
    end)

    -- tab bar
    local tabs = Instance.new("Frame")
    tabs.Size = UDim2.new(1, 0, 0, 32)
    tabs.Position = UDim2.new(0, 0, 0, 36)
    tabs.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
    tabs.BorderSizePixel = 0
    tabs.Parent = frame

    -- content
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, -68)
    content.Position = UDim2.new(0, 0, 0, 68)
    content.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    content.BorderSizePixel = 0
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.ScrollBarThickness = 4
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.Parent = frame

    local api = { Frame = frame, Content = content }
    api.Tabs = {}

    function api.AddTab(name)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 106, 0, 30)
        btn.Position = UDim2.new(0, 106 * (api.TabsLen or 0), 0, 1)
        btn.BackgroundColor3 = Color3.fromRGB(24, 24, 40)
        btn.BorderSizePixel = 0
        btn.Text = name
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextColor3 = Color3.fromRGB(200, 200, 210)
        btn.Parent = tabs
        api.TabsLen = (api.TabsLen or 0) + 1

        local page = Instance.new("Frame")
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.Parent = content

        local y = 0
        local pageApi = {}
        pageApi.Page = page

        function pageApi.AddToggle(text, default)
            y = y + 34
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -16, 0, 30)
            row.Position = UDim2.new(0, 8, 0, y)
            row.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
            row.BorderSizePixel = 0
            row.Parent = page

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -44, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local tog = Instance.new("TextButton")
            tog.Size = UDim2.new(0, 34, 0, 20)
            tog.Position = UDim2.new(1, -40, 0.5, -10)
            tog.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            tog.BorderSizePixel = 0
            tog.Text = "OFF"
            tog.Font = Enum.Font.GothamBold
            tog.TextSize = 10
            tog.TextColor3 = Color3.fromRGB(180, 180, 190)
            tog.Parent = row

            local state = default or false
            local function refresh()
                tog.Text = state and "ON" or "OFF"
                tog.BackgroundColor3 = state and Color3.fromRGB(30, 160, 110)
                                             or Color3.fromRGB(60, 60, 70)
                tog.TextColor3 = state and Color3.fromRGB(255, 255, 255)
                                       or Color3.fromRGB(180, 180, 190)
            end
            refresh()
            tog.MouseButton1Click:Connect(function()
                state = not state
                refresh()
                if onChange then onChange(state) end
            end)
            return { Get = function() return state end,
                     Set = function(v) state = v refresh() end }
        end

        function pageApi.AddSlider(text, min, max, default)
            y = y + 44
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -16, 0, 40)
            row.Position = UDim2.new(0, 8, 0, y)
            row.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
            row.BorderSizePixel = 0
            row.Parent = page

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Text = text .. " : " .. tostring(default)
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, -16, 0, 4)
            bar.Position = UDim2.new(0, 8, 0, 24)
            bar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            bar.BorderSizePixel = 0
            bar.Parent = row

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(80, 255, 200)
            fill.BorderSizePixel = 0
            fill.Parent = bar

            local value = default
            local dragging2 = false
            local function setFromMouse()
                local rel = UserInput:GetMouseLocation().X - bar.AbsolutePosition.X
                local frac = math.clamp(rel / bar.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * frac + 0.5)
                fill.Size = UDim2.new(frac, 0, 1, 0)
                lbl.Text = text .. " : " .. tostring(value)
            end
            bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging2 = true
                    setFromMouse()
                end
            end)
            UserInput.InputChanged:Connect(function(i)
                if dragging2 and i.UserInputType == Enum.UserInputType.MouseMovement then
                    setFromMouse()
                end
            end)
            UserInput.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging2 = false
                end
            end)
            return { Get = function() return value end,
                     Set = function(v) value = v lbl.Text = text .. " : " .. tostring(v) end }
        end

        function pageApi.AddButton(text, cb)
            y = y + 36
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -16, 0, 32)
            btn.Position = UDim2.new(0, 8, 0, y)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 48)
            btn.BorderSizePixel = 0
            btn.Text = text
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 13
            btn.TextColor3 = Color3.fromRGB(120, 255, 220)
            btn.Parent = page
            btn.MouseButton1Click:Connect(function()
                if cb then cb() end
            end)
            return btn
        end

        function pageApi.AddDropdown(text, options, onSelect)
            y = y + 36
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -16, 0, 32)
            btn.Position = UDim2.new(0, 8, 0, y)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 48)
            btn.BorderSizePixel = 0
            btn.Text = text .. " : " .. (options[1] or "?")
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            btn.TextColor3 = Color3.fromRGB(220, 220, 230)
            btn.Parent = page
            local idx = 1
            btn.MouseButton1Click:Connect(function()
                idx = idx % #options + 1
                btn.Text = text .. " : " .. options[idx]
                if onSelect then onSelect(options[idx]) end
            end)
            return { Get = function() return options[idx] end }
        end

        btn.MouseButton1Click:Connect(function()
            for _, other in ipairs(api.Tabs) do
                other.Page.Visible = false
                other.Btn.BackgroundColor3 = Color3.fromRGB(24, 24, 40)
            end
            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
        end)

        table.insert(api.Tabs, { Page = page, Btn = btn })
        return pageApi
    end

    -- show first tab
    task.defer(function()
        if api.Tabs[1] then
            api.Tabs[1].Page.Visible = true
            api.Tabs[1].Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
        end
    end)

    return api
end

