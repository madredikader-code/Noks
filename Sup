local Features = {}

-- WalkSpeed / JumpPower loop
RunService.Heartbeat:Connect(function()
    local char = GetCharacter()
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = CONFIG.WalkSpeed
        hum.JumpPower = CONFIG.JumpPower
    end
end)

-- Noclip
RunService.Stepped:Connect(function()
    if not CONFIG.Noclip then return end
    local char = GetCharacter()
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end)

-- Infinite Jump
UserInput.JumpRequest:Connect(function()
    if not CONFIG.InfiniteJump then return end
    local char = GetCharacter()
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if hum and root then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        root.Velocity = Vector3.new(root.Velocity.X, 60, root.Velocity.Z)
    end
end)

-- ESP (Highlight eggs + guards)
local Highlights = {}
local function ClearESP()
    for _, h in ipairs(Highlights) do
        if h then pcall(function() h:Destroy() end) end
    end
    Highlights = {}
end

RunService.Heartbeat:Connect(function()
    if not CONFIG.ESP then
        if #Highlights > 0 then ClearESP() end
        return
    end
    -- eggs
    for _, egg in ipairs(FindObjects(CONFIG.EggNames)) do
        if not egg:FindFirstChild("NOKS_HL") then
            local hl = Instance.new("Highlight")
            hl.Name = "NOKS_HL"
            hl.FillColor = Color3.fromRGB(255, 200, 40)
            hl.FillTransparency = 0.4
            hl.OutlineColor = Color3.fromRGB(255, 120, 0)
            hl.Parent = egg
            table.insert(Highlights, hl)
        end
    end
    -- guards
    for _, guard in ipairs(FindObjects(CONFIG.GuardNames)) do
        if not guard:FindFirstChild("NOKS_HL_G") then
            local hl = Instance.new("Highlight")
            hl.Name = "NOKS_HL_G"
            hl.FillColor = Color3.fromRGB(255, 60, 60)
            hl.FillTransparency = 0.45
            hl.OutlineColor = Color3.fromRGB(200, 0, 0)
            hl.Parent = guard
            table.insert(Highlights, hl)
        end
    end
end)

-- Auto Farm: find nearest egg, go steal it, come back to base
task.spawn(function()
    while true do
        task.wait(0.3)
        if not CONFIG.AutoFarm then
            task.wait(0.5)
        else
            local char = GetCharacter()
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then task.wait(1) else
                local best, bestDist
                for _, egg in ipairs(FindObjects(CONFIG.EggNames)) do
                    local d = (egg.Position - root.Position).Magnitude
                    if not bestDist or d < bestDist then
                        best, bestDist = egg, d
                    end
                end
                if best then
                    TeleportTo(CFrame.new(best.Position + Vector3.new(0, 3, 0)))
                    FireNearbyPrompts(12)
                    task.wait(0.5)
                    -- return to base with the egg
                    if CONFIG.BasePosition then
                        TeleportTo(CFrame.new(CONFIG.BasePosition))
                        FireNearbyPrompts(12)
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)

-- Auto Collect / Auto Train / Auto Rebirth (fire nearby prompts)
task.spawn(function()
    while true do
        task.wait(0.4)
        if CONFIG.AutoCollect or CONFIG.AutoTrain or CONFIG.AutoRebirth then
            FireNearbyPrompts(14)
        end
    end
end)

